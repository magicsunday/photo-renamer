# User/Group ID for Docker container
USERID=1000
GROUPID=1000

# Existing host collection directory; runtime commands use /media inside Docker.
# Set true for read-only verify/dry-run; rename/write-date/dedup need false.
MEDIA_DIR=./images
MEDIA_READ_ONLY=false

# Finite PHP budget and independent container/native resource boundaries.
# Increase RAM and PHP budgets together only after measuring collection needs.
PHP_MEMORY_LIMIT=1024M
RUNTIME_MEMORY_LIMIT=2g
RUNTIME_CPUS=2.0
RUNTIME_PIDS_LIMIT=128
RUNTIME_TMP_SIZE=512m

# Default timezone for video files without timezone metadata.
# QuickTime/MP4 timestamps are stored in UTC. This timezone is used
# to convert them to local time. Does not affect EXIF dates in images
# (those are already in local camera time).
# See: https://www.php.net/manual/en/timezones.php
TIMEZONE=Europe/Berlin

# Maximum allowed date drift in days between source filename date and
# target date. Files exceeding this threshold are flagged as [W] Warning
# and skipped. Set to 0 to disable the check.
MAX_DATE_DRIFT=7

# Finite candidate-pair visits per capture group and cross-group video batch.
# Counts visited group/membership exclusions too; conflicting known Live Photo IDs
# are indexed out without pair visits. Exhaustion reports incomplete analysis; it never
# treats unexamined pairs as duplicates. Positive integer only, no unlimited mode.
MAX_COMPARISON_PAIRS=100000

# Development/standalone cache base. Isolated runtime uses the Docker media-cache
# volume at /cache; clear it with make runtime-cache-clear.
# private-<effective UID>/ is created with 0700.
# JSON files are 0600. Existing shared parent permissions are left unchanged.
# Default: .build/cache (relative to project root)
CACHE_DIR=.build/cache

# Maximum RMSE (0.0–1.0) for merging perceptually similar files.
# Pairs with RMSE at or above this threshold are kept as separate
# sub-groups instead of merged as duplicates. Internal safe limits
# still cap the effective threshold, so lower values only make the
# policy stricter.
# HEIC↔JPG format conversions: 0.001–0.013. Different photos: 0.25+.
# Override per run with --merge-threshold CLI flag on rename:exif.
MERGE_THRESHOLD=0.06

# Format priority for canonical selection (comma-separated, highest first).
# When multiple files map to the same target name, the file with the
# highest-priority format becomes canonical.
CANONICAL_FORMAT_PRIORITY=heic,heif,dng,arw,jpg,jpeg,mov,mp4,m4v,avi

# Clickable file links in terminal output (OSC 8 hyperlinks).
# FILE_LINK_ROOT is the source path as seen inside Docker/NAS.
# FILE_LINK_BASE is the same path as seen from the terminal host.
# When both are set, file paths become clickable (Ctrl+Click) in
# terminals that support hyperlinks (PhpStorm, VS Code, iTerm2).
#
# Examples:
#   FILE_LINK_ROOT=/media            FILE_LINK_BASE=Z:\Photos
#   FILE_LINK_ROOT=/media            FILE_LINK_BASE=\\NAS\Photos
#   FILE_LINK_ROOT=/media            FILE_LINK_BASE=/mnt/nas/photos
#
# FILE_LINK_PROTOCOL sets the URI scheme for links:
#   (empty)        = file:// linking to the parent directory (default)
#   photo-select   = custom protocol that opens Explorer with file selected
#                    (requires scripts/windows/install-protocol.ps1 setup)
#
# Leave FILE_LINK_ROOT and FILE_LINK_BASE empty to disable clickable links.
FILE_LINK_ROOT=
FILE_LINK_BASE=
FILE_LINK_PROTOCOL=
