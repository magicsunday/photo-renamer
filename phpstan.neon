includes:
    - %currentWorkingDirectory%/.build/vendor/magicsunday/coding-standard/phpstan/base.neon

parameters:
    # level: max, the rule packs (strict, deprecation, phpunit) and checked exceptions
    # come from the shared base.

    # Single-PHP application: 8.5 is both floor and ceiling.
    phpVersion: 80500

    tmpDir: %currentWorkingDirectory%/.build/cache/.phpstan.cache

    paths:
        - %currentWorkingDirectory%/src/
        - %currentWorkingDirectory%/tests/

    excludePaths:
        - %currentWorkingDirectory%/.build/
        - %currentWorkingDirectory%/src/Renamer.php
        - %currentWorkingDirectory%/src/Dependencies.php

    ignoreErrors:
        # A test method that calls a throwing API documents nothing by carrying @throws: PHPUnit
        # catches whatever it throws and turns it into a failure (or an expectException pass).
        # Checked-exception contracts are enforced on src/, where callers depend on them.
        -
            identifier: missingType.checkedException
            path: %currentWorkingDirectory%/tests/*
