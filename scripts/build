#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
bash scripts/check-lock.sh

ROOT_DIR="$(pwd)"
BUILD_DIR="${ROOT_DIR}/.build/renamer"
BIN_DIR="${ROOT_DIR}/.build/bin"
SPC_DIR="${ROOT_DIR}/.build/spc"
BIN_NAME="renamer"

echo "Compiling ${BIN_NAME}"

if [[ ! -f /.dockerenv ]]; then
    echo "Run the binary build through make binary inside Docker." >&2
    exit 1
fi
unset GITHUB_TOKEN GH_TOKEN COMPOSER_AUTH
bash scripts/ensure-spc.sh "${BIN_DIR}/spc"
bash scripts/bootstrap-state.sh verify

rm -rf "${BUILD_DIR}"

echo "Creating build directory"
mkdir "${BUILD_DIR}"

echo "Copying files"
cp composer.json "${BUILD_DIR}"
cp composer.lock "${BUILD_DIR}"
cp -r src "${BUILD_DIR}"
cp -r config "${BUILD_DIR}"
cp version Dockerfile "${BUILD_DIR}"
mkdir -p "${BUILD_DIR}/scripts"
cp scripts/write-build-manifest.php "${BUILD_DIR}/scripts/"

echo "Installing composer dependencies"
"${BIN_DIR}/php" /usr/bin/composer --working-dir "${BUILD_DIR}" install --no-dev --no-ansi --no-interaction --no-progress --no-scripts --classmap-authoritative

echo "Stripping non-essential vendor files"

bash scripts/strip-vendor.sh "${BUILD_DIR}/.build/vendor"

"${BIN_DIR}/php" "${BUILD_DIR}/scripts/write-build-manifest.php" "${BUILD_DIR}/.build/build-inputs.json" "${APP_REVISION:-workspace}" "${APP_SOURCE_DIRTY:-1}" binary "${ROOT_DIR}"
cp "${BUILD_DIR}/.build/build-inputs.json" "${ROOT_DIR}/renamer.build.json"

echo "Creating phar archive"
"${BIN_DIR}/php" scripts/build.php

echo "Cleaning up"
rm -rf "${BUILD_DIR}"

echo "Building self-containing binary"
"${BIN_DIR}/spc" micro:combine "${BIN_NAME}.phar" --output="${BIN_NAME}" --with-micro="${SPC_DIR}/buildroot/bin/micro.sfx"
rm "${BIN_NAME}.phar"

# The native artifact must mutate only its disposable probe with default host state.
bash scripts/check-binary-state.sh "${ROOT_DIR}/${BIN_NAME}"
