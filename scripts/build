#!/usr/bin/env bash

set -e

cd "$(dirname "${BASH_SOURCE[0]}")/.."

ROOT_DIR="$(pwd)"
BUILD_DIR="${ROOT_DIR}/.build/renamer"
BIN_DIR="${ROOT_DIR}/.build/bin"
SPC_DIR="${ROOT_DIR}/.build/spc"
BIN_NAME="renamer"

# Non-essential vendor directories removed before PHAR creation
STRIP_DIRS=(docs doc tests test test-images scripts Make .github examples)

# Non-essential vendor files removed before PHAR creation
STRIP_FILES=(
    'README*' 'LICENSE*' 'CHANGELOG*' 'CONTRIBUTING*' 'AGENTS.md' 'CLAUDE.md'
    '.gitignore' '.gitattributes' 'phpunit.xml*' 'phpstan*' 'rector*'
    '.php-cs-fixer*' 'Makefile' 'composer.json' 'composer.lock'
)

echo "Compiling ${BIN_NAME}"

# Auto-initialize SPC build environment if needed
if [ ! -f "${BIN_DIR}/php" ] || [ ! -f "${BIN_DIR}/composer" ] || [ ! -f "${SPC_DIR}/buildroot/bin/micro.sfx" ]; then
    echo "SPC build environment not found, initializing..."
    ./scripts/init-with-docker
fi

rm -rf "${BUILD_DIR}"

echo "Creating build directory"
mkdir "${BUILD_DIR}"

echo "Copying files"
cp composer.json "${BUILD_DIR}"
cp composer.lock "${BUILD_DIR}" 2>/dev/null || :
cp -r src "${BUILD_DIR}"
cp -r config "${BUILD_DIR}"
cp version "${BUILD_DIR}"

echo "Installing composer dependencies"
"${BIN_DIR}/composer" -d "${BUILD_DIR}" install --no-dev --no-ansi --no-interaction --no-progress --no-scripts --classmap-authoritative

echo "Stripping non-essential vendor files"

dir_args=()
for dir in "${STRIP_DIRS[@]}"; do
    dir_args+=(-o -name "$dir")
done
# Remove leading -o
find "${BUILD_DIR}/.build/vendor" -mindepth 3 -maxdepth 3 -type d \
    \( "${dir_args[@]:1}" \) -exec rm -rf {} + || :

file_args=()
for file in "${STRIP_FILES[@]}"; do
    file_args+=(-o -iname "$file")
done
find "${BUILD_DIR}/.build/vendor" -mindepth 3 -maxdepth 3 -type f \
    \( "${file_args[@]:1}" \) -delete || :

echo "Creating phar archive"
"${BIN_DIR}/php" scripts/build.php

echo "Cleaning up"
rm -rf "${BUILD_DIR}"

echo "Building self-containing binary"
"${BIN_DIR}/spc" micro:combine "${BIN_NAME}.phar" --output="${BIN_NAME}" --with-micro="${SPC_DIR}/buildroot/bin/micro.sfx"
rm "${BIN_NAME}.phar"
