#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Build artifacts belong to the invoking user. Existing runtime configuration
# stays byte-for-byte intact; override only the builder invocation's identity.
export USERID="$(id -u)"
export GROUPID="$(id -g)"

# A fresh checkout keeps all documented defaults, not just two identity keys.
# Treat dangling symlinks as existing paths rather than overwriting their target.
if [[ ! -e .env && ! -L .env ]]; then
    sed -e "s/^USERID=.*/USERID=${USERID}/" \
        -e "s/^GROUPID=.*/GROUPID=${GROUPID}/" .env.dist > .env
fi

# Fix .build/ ownership (created as root by buildbox) so builder container can write to it
if [ -d ".build" ]; then
    docker compose run --rm buildbox chown -R "$(id -u):$(id -g)" /app/.build
fi

# Pass GitHub token to avoid API rate limiting
if [ -z "${GITHUB_TOKEN:-}" ]; then
    if command -v gh >/dev/null 2>&1; then
        GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
    fi

    if [ -z "${GITHUB_TOKEN:-}" ]; then
        echo "Error: GITHUB_TOKEN is not set and 'gh' is not available or not authenticated"
        exit 1
    fi
fi

export GITHUB_TOKEN
# Tokens exist only in the short-lived downloader container. Compilation uses
# a fresh container, whose Docker configuration and parent environment are clear.
docker compose run --rm -e GITHUB_TOKEN builder ./scripts/init download
docker compose run --rm -e GITHUB_TOKEN= -e GH_TOKEN= -e COMPOSER_AUTH= builder ./scripts/init compile
