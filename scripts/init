#!/usr/bin/env bash

set -e

PHP_EXTENSIONS="curl,dom,exif,fileinfo,filter,iconv,imagick,mbstring,openssl,pcntl,phar,posix,tokenizer,yaml,xml,xmlreader,xmlwriter,zlib"

cd "$(dirname "${BASH_SOURCE[0]}")/.."

ROOT_DIR="$(pwd)"
SPC_DIR="${ROOT_DIR}/.build/spc"
BIN_DIR="${ROOT_DIR}/.build/bin"
SPC="${BIN_DIR}/spc"

mkdir -p "${SPC_DIR}" "${BIN_DIR}"

# Skip if SPC is already fully built
if [ -f "${SPC_DIR}/buildroot/bin/micro.sfx" ] && [ -f "${BIN_DIR}/php" ] && [ -f "${BIN_DIR}/composer" ]; then
    echo "SPC build environment already exists, skipping (use 'make binary-clean' to rebuild)"
    exit 0
fi

if [ ! -f "${SPC}" ]; then
    echo "Download SPC binary command"
    curl -fsSL -o "${SPC}" https://dl.static-php.dev/static-php-cli/spc-bin/nightly/spc-linux-x86_64
    chmod +x "${SPC}"
fi

cd "${SPC_DIR}"

echo "Check system tool dependencies, auto-fix them if possible"
"${SPC}" doctor --auto-fix

if [ ! -f "pkgroot/bin/upx" ]; then
    echo "Download UPX command"
    "${SPC}" install-pkg upx
fi

echo "Download SPC extensions"
"${SPC}" download --with-php=8.5 --for-extensions "${PHP_EXTENSIONS}" --prefer-pre-built --without-suggestions

echo "Compile SPC"
"${SPC}" build --build-cli --build-micro --with-micro-fake-cli --with-upx-pack "${PHP_EXTENSIONS}" -I "phar.readonly=Off" -I "memory_limit=-1" -I "error_reporting=-1"

ln -sf "../spc/buildroot/bin/php" "${BIN_DIR}/php"

echo "Install Composer"
curl -fsSL -o composer-setup.php https://getcomposer.org/installer

EXPECTED_CHECKSUM="$("${BIN_DIR}/php" -r 'copy("https://composer.github.io/installer.sig", "php://stdout");')"
ACTUAL_CHECKSUM="$("${BIN_DIR}/php" -r "echo hash_file('sha384', 'composer-setup.php');")"

if [ "$EXPECTED_CHECKSUM" != "$ACTUAL_CHECKSUM" ]; then
    >&2 echo 'ERROR: Invalid Composer installer checksum'
    rm composer-setup.php
    exit 1
fi

"${BIN_DIR}/php" composer-setup.php
rm composer-setup.php

if [ -f "composer.phar" ]; then
    "${SPC}" micro:combine composer.phar --output=composer
    rm composer.phar
    mv composer "${BIN_DIR}/composer"
else
    echo "Composer download failed"
    exit 1
fi
