#!/usr/bin/env bash

set -euo pipefail

PHP_EXTENSIONS="ctype,curl,dom,exif,fileinfo,filter,iconv,imagick,mbstring,openssl,pcntl,phar,posix,xml,xmlreader,xmlwriter,zlib"

cd "$(dirname "${BASH_SOURCE[0]}")/.."

ROOT_DIR="$(pwd)"
SPC_DIR="${ROOT_DIR}/.build/spc"
BIN_DIR="${ROOT_DIR}/.build/bin"
SPC="${BIN_DIR}/spc"

mkdir -p "${SPC_DIR}" "${BIN_DIR}"

# Every cache reuse is verified before the early-return or any tool call.
bash scripts/ensure-spc.sh "${SPC}"

source config/build-inputs.env
bootstrap_phase="${1:-all}"
case "${bootstrap_phase}" in download|compile|all) ;; *) echo "Expected download or compile bootstrap phase." >&2; exit 1 ;; esac
# Cached compiler outputs are reusable only with the same reviewed inputs.
if [[ -f "${SPC_DIR}/buildroot/bin/micro.sfx" && -f "${BIN_DIR}/php" ]]; then
    bash scripts/bootstrap-state.sh verify
    echo "SPC build environment already exists, skipping (use 'make binary-clean' to rebuild)"
    exit 0
fi

cd "${SPC_DIR}"

if [[ "${bootstrap_phase}" != compile ]]; then
    echo "Check system tool dependencies, auto-fix them if possible"
    env -u GITHUB_TOKEN -u GH_TOKEN -u COMPOSER_AUTH "${SPC}" doctor --auto-fix

    if [ ! -f "pkgroot/bin/upx" ]; then
        echo "Download UPX command"
        "${SPC}" install-pkg upx
    fi

    echo "Download SPC extensions"
    "${SPC}" download --with-php=8.5 --custom-url "php-src:https://www.php.net/distributions/php-${PHP_BUILD_VERSION}.tar.xz" --for-extensions "${PHP_EXTENSIONS}" --prefer-pre-built --without-suggestions
fi
if [[ "${bootstrap_phase}" == download ]]; then
    echo "Bootstrap downloads complete; start compile in a fresh credential-free container."
    bash "${ROOT_DIR}/scripts/native-inputs.sh" record
    exit 0
fi

# Download does not extract sources. Verify the selected archive before build.
php_source="downloads/php-${PHP_BUILD_VERSION}.tar.xz"
if [[ ! -f "${php_source}" || -L "${php_source}" ]]; then
    echo "The pinned PHP source archive is missing or linked." >&2
    exit 1
fi
php_source_hash="$(sha256sum < "${php_source}")"
if [[ "${php_source_hash%% *}" != "${PHP_SOURCE_SHA256}" ]]; then
    echo "PHP source checksum mismatch; compilation will not run." >&2
    exit 1
fi

if [[ "${bootstrap_phase}" == compile ]]; then bash "${ROOT_DIR}/scripts/native-inputs.sh" verify; fi

# Download authentication ends here; all remaining compile/combine children
# inherit no download credentials, including later Composer micro-combination.
unset GITHUB_TOKEN GH_TOKEN COMPOSER_AUTH
echo "Compile SPC"
"${SPC}" build --build-cli --build-micro --with-micro-fake-cli --with-upx-pack "${PHP_EXTENSIONS}" -I "phar.readonly=Off" -I "memory_limit=1024M" -I "error_reporting=-1"

ln -sf "../spc/buildroot/bin/php" "${BIN_DIR}/php"

# Composer PHAR is copied from the pinned official image by Dockerfile.
# No mutable installer and no separately packed Composer executable are needed.
"${BIN_DIR}/php" /usr/bin/composer --version --no-ansi
cd "${ROOT_DIR}"
bash scripts/native-inputs.sh record
bash scripts/bootstrap-state.sh record
