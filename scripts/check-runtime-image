#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

MIN_FFMPEG_VERSION="${MIN_FFMPEG_VERSION:-8.1.2-r0}"
IMAGE_NAME="$(docker compose config --images | grep 'buildbox$' | head -n 1)"
IMAGE_ID="$(docker image inspect "${IMAGE_NAME}" --format '{{.Id}}')"

if [ "${IMAGE_NAME}" = "" ] || [ "${IMAGE_ID}" = "" ]; then
    echo "The buildbox runtime image is not available." >&2
    exit 1
fi

echo "Runtime image: ${IMAGE_NAME} (${IMAGE_ID})"
docker compose run --rm --user root buildbox bash /app/scripts/runtime-image-smoke "${MIN_FFMPEG_VERSION}"

echo "Runtime image verification passed"
