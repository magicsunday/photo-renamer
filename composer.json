{
    "name": "magicsunday/photo-renamer",
    "description": "Renames photos using EXIF date, patterns, filesize, ...",
    "license": "MIT",
    "keywords": [
        "rename",
        "live",
        "photo",
        "live photos",
        "Apple",
        "videos"
    ],
    "authors": [
        {
            "name": "Rico Sonntag",
            "email": "mail@ricosonntag.de",
            "homepage": "https://ricosonntag.de",
            "role": "Developer"
        }
    ],
    "config": {
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false
    },
    "repositories": {
        "magicsunday/imagemeta": {
            "type": "github",
            "url": "git@github.com:magicsunday/imagemeta.git"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "magicsunday/imagemeta": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85",
        "overtrue/phplint": "^9.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MagicSunday\\Renamer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagicSunday\\Renamer\\Test\\": "test/"
        }
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config .build/.php-cs-fixer.dist.php --diff --verbose"
        ],
        "ci:rector": [
            "rector process --config .build/rector.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:lint": [
            "phplint --configuration .build/.phplint.yml"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration .build/phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:phpstan:baseline": [
            "phpstan analyze --configuration .build/phpstan.neon --memory-limit=-1 --generate-baseline .build/phpstan-baseline.neon --allow-empty-baseline"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:unit": [
            "phpunit --configuration .build/phpunit.xml"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:cgl",
            "@ci:test:php:unit"
        ]
    }
}
