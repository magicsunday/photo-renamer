{
    "name": "magicsunday/photo-renamer",
    "description": "Batch-rename and deduplicate photos and videos using EXIF/QuickTime metadata, perceptual hashing, and Apple Live Photo pairing.",
    "license": "MIT",
    "keywords": [
        "rename",
        "photo",
        "video",
        "exif",
        "live photos",
        "duplicate detection",
        "perceptual hash",
        "Apple"
    ],
    "authors": [
        {
            "name": "Rico Sonntag",
            "email": "mail@ricosonntag.de",
            "homepage": "https://ricosonntag.de",
            "role": "Developer"
        }
    ],
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false,
        "process-timeout": 0,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "repositories": {
        "magicsunday/imagemeta": {
            "type": "github",
            "url": "git@github.com:magicsunday/imagemeta.git"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-imagick": "*",
        "ext-mbstring": "*",
        "magicsunday/imagemeta": "dev-main",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85",
        "infection/infection": "^0.35",
        "overtrue/phplint": "^9.0",
        "phpat/phpat": "^0.12.4",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.2",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MagicSunday\\Renamer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagicSunday\\Renamer\\Test\\": "tests/"
        }
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --verbose"
        ],
        "ci:rector": [
            "rector process --config rector.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:lint": [
            "phplint --configuration .phplint.yml"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:unit": [
            "phpunit --configuration phpunit.xml"
        ],
        "ci:test:php:unit:coverage": [
            "@php -d pcov.enabled=1 .build/bin/phpunit --configuration phpunit.xml --coverage-html .build/coverage --coverage-clover .build/coverage/clover.xml"
        ],
        "ci:test:php:cpd": [
            "npx --prefix .build jscpd --config .jscpd.json --skip-comments --no-tips"
        ],
        "ci:test:php:audit": [
            "composer audit --format=plain"
        ],
        "ci:test:php:mutation": [
            "@putenv COMPOSER_PROCESS_TIMEOUT=0",
            "@php -d pcov.enabled=1 .build/bin/infection --configuration=infection.json5 --threads=4 --initial-tests-php-options=\"-d pcov.enabled=1\" --only-covering-test-cases"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:cgl",
            "@ci:test:php:rector",
            "@ci:test:php:phpstan",
            "@ci:test:php:unit",
            "@ci:test:php:cpd"
        ],
        "post-update-cmd": [
            "npm install --prefix .build jscpd@^5.0.11"
        ],
        "post-install-cmd": [
            "npm install --prefix .build jscpd@^5.0.11"
        ]
    }
}
